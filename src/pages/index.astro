          { name: 'Grapefruit ade', ko: '자몽에이드', km: 'ទឹកក្រូចថ្លុងសូដា', price: '$2.75' },
          { name: 'Peach iced tea', ko: '복숭아 아이스티', km: 'តែប៉េសទឹកកក', price: '$2.25' },
