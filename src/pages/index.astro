---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/60 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-leaf/30 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-brand"></span>
            Korean-style café · Siem Reap
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            A little taste of <span class="text-brand">Seoul</span> in Siem Reap.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">រសជាតិកូរ៉េបន្តិច នៅខេត្តសៀមរាប</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Iced coffee, strawberry lattes, bingsu and croffles, in a calm and cozy café. 오늘도 좋은 하루! Have a good day!
            <span class="km" lang="km">កាហ្វេទឹកកក ឡាតេស្ត្របឺរី ប៊ីងស៊ូ និងក្រូហ្វល នៅក្នុងហាងកាហ្វេដ៏ស្ងប់ស្ងាត់ និងកក់ក្តៅ។ សូមឱ្យមានថ្ងៃល្អ!</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#menu" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              See the menu → <span lang="km" class="font-khmer font-normal opacity-80">មើលម៉ឺនុយ</span>
            </a>
            <a href="#visit" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              Find us <span lang="km" class="font-khmer font-normal opacity-60">ទីតាំង</span>
            </a>
          </div>
        </div>

        <!-- Illustration: inside a cozy Korean café, with a bear barista holding a
             strawberry latte. Drawn in SVG, so it is tiny and stays sharp. -->
        <div class="relative" aria-hidden="true">
          <svg viewBox="0 0 400 400" class="mx-auto block aspect-square w-full max-w-md rounded-[2.5rem] shadow-2xl" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <clipPath id="frame"><rect width="400" height="400" rx="40" /></clipPath>
              <linearGradient id="wall" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f7ebe0" />
                <stop offset="1" stop-color="#f1dccb" />
              </linearGradient>
              <radialGradient id="lampGlow">
                <stop offset="0" stop-color="#fff2c8" stop-opacity="0.9" />
                <stop offset="1" stop-color="#fff2c8" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="latte" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f4b6b0" />
                <stop offset="1" stop-color="#fdeeea" />
              </linearGradient>
            </defs>
            <g clip-path="url(#frame)">
              <!-- Wall and wood panel -->
              <rect width="400" height="400" fill="url(#wall)" />
              <rect y="215" width="400" height="60" fill="#e8cdb6" />
              <g stroke="#dcbca2" stroke-width="2">
                <line x1="40" y1="215" x2="40" y2="275" /><line x1="100" y1="215" x2="100" y2="275" />
                <line x1="300" y1="215" x2="300" y2="275" /><line x1="360" y1="215" x2="360" y2="275" />
              </g>

              <!-- Hanging lamps with warm glow -->
              {[80, 320].map((x) => (
                <g>
                  <circle cx={x} cy="78" r="60" fill="url(#lampGlow)" />
                  <line x1={x} y1="0" x2={x} y2="52" stroke="#7a4632" stroke-width="2" />
                  <path d={`M${x - 22} 72 a22 22 0 0 1 44 0Z`} fill="#9c5f44" />
                  <circle cx={x} cy="74" r="6" fill="#fff2c8" />
                </g>
              ))}

              <!-- Menu board -->
              <rect x="140" y="34" width="120" height="78" rx="10" fill="#5a3526" />
              <rect x="146" y="40" width="108" height="66" rx="6" fill="none" stroke="#c8a58c" stroke-width="1.5" stroke-dasharray="3 3" />
              <text x="200" y="62" text-anchor="middle" font-size="15" font-weight="800" fill="#fcf8f3" letter-spacing="2">MENU</text>
              <text x="200" y="78" text-anchor="middle" font-size="10" fill="#f6d9d5">메뉴 · ម៉ឺនុយ</text>
              <g stroke="#c8a58c" stroke-width="2" stroke-linecap="round">
                <line x1="160" y1="90" x2="214" y2="90" /><line x1="226" y1="90" x2="240" y2="90" />
                <line x1="160" y1="99" x2="204" y2="99" /><line x1="226" y1="99" x2="240" y2="99" />
              </g>

              <!-- Plant on a shelf -->
              <rect x="318" y="168" width="64" height="6" rx="3" fill="#9c5f44" />
              <path d="M334 168 h32 l-4 -22 h-24z" fill="#fcf8f3" stroke="#e1c7b3" stroke-width="2" />
              <g fill="#8fae78">
                <ellipse cx="342" cy="130" rx="8" ry="18" transform="rotate(-25 342 130)" />
                <ellipse cx="358" cy="126" rx="8" ry="20" transform="rotate(20 358 126)" />
                <ellipse cx="350" cy="122" rx="7" ry="20" />
              </g>

              <!-- Bear barista -->
              <g>
                <!-- ears -->
                <circle cx="160" cy="160" r="20" fill="#a9734f" /><circle cx="160" cy="160" r="10" fill="#f1c4b5" />
                <circle cx="240" cy="160" r="20" fill="#a9734f" /><circle cx="240" cy="160" r="10" fill="#f1c4b5" />
                <!-- body with apron -->
                <path d="M128 300 Q128 236 200 236 Q272 236 272 300Z" fill="#a9734f" />
                <path d="M168 248 H232 V300 H168Z" fill="#fcf8f3" />
                <path d="M168 248 Q200 262 232 248" fill="none" stroke="#e9a8a0" stroke-width="3" />
                <!-- head -->
                <circle cx="200" cy="196" r="50" fill="#b98361" />
                <ellipse cx="200" cy="214" rx="22" ry="17" fill="#f3dcc8" />
                <ellipse cx="200" cy="206" rx="8" ry="6" fill="#4a2a1c" />
                <path d="M193 218 q7 6 14 0" fill="none" stroke="#4a2a1c" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="180" cy="190" r="5" fill="#4a2a1c" /><circle cx="182" cy="188" r="1.6" fill="#ffffff" />
                <circle cx="220" cy="190" r="5" fill="#4a2a1c" /><circle cx="222" cy="188" r="1.6" fill="#ffffff" />
                <ellipse cx="166" cy="210" rx="8" ry="5" fill="#e9a8a0" opacity="0.8" />
                <ellipse cx="234" cy="210" rx="8" ry="5" fill="#e9a8a0" opacity="0.8" />
                <!-- little barista cap -->
                <path d="M168 156 Q200 132 232 156 Q200 148 168 156Z" fill="#7a4632" />
              </g>

              <!-- Counter -->
              <rect y="290" width="400" height="110" fill="#9c5f44" />
              <rect y="284" width="400" height="12" rx="4" fill="#7a4632" />
              <g stroke="#8a513a" stroke-width="2">
                <line x1="100" y1="300" x2="100" y2="400" /><line x1="200" y1="300" x2="200" y2="400" /><line x1="300" y1="300" x2="300" y2="400" />
              </g>

              <!-- Strawberry latte in the bear's paws -->
              <rect x="212" y="222" width="7" height="44" rx="3.5" fill="#9c5f44" transform="rotate(10 215 244)" />
              <path d="M184 238 H216 L212 286 Q211 290 207 290 H193 Q189 290 188 286Z" fill="url(#latte)" stroke="#ffffff" stroke-width="2.5" />
              <rect x="181" y="234" width="38" height="6" rx="3" fill="#ffffff" />
              <path d="M200 270 c-5 -3.6 -7.5 -6.4 -7.5 -9.2 0 -2.2 1.6 -3.8 3.6 -3.8 1.6 0 2.8 1 3.9 2.4 1.1 -1.4 2.3 -2.4 3.9 -2.4 2 0 3.6 1.6 3.6 3.8 0 2.8 -2.5 5.6 -7.5 9.2z" fill="#e9a8a0" />
              <ellipse cx="180" cy="270" rx="12" ry="10" fill="#a9734f" />
              <ellipse cx="220" cy="270" rx="12" ry="10" fill="#a9734f" />

              <!-- Cake on a stand (left) -->
              <ellipse cx="70" cy="284" rx="40" ry="6" fill="#fcf8f3" />
              <rect x="66" y="272" width="8" height="12" fill="#fcf8f3" />
              <ellipse cx="70" cy="272" rx="34" ry="5" fill="#fcf8f3" />
              <path d="M44 270 V244 Q70 232 96 244 V270Z" fill="#fff6ee" />
              <rect x="44" y="254" width="52" height="5" fill="#e9a8a0" />
              <path d="M44 244 Q70 232 96 244 Q70 250 44 244Z" fill="#fcf8f3" />
              <circle cx="60" cy="238" r="5" fill="#e05a5a" /><circle cx="76" cy="236" r="5" fill="#e05a5a" /><circle cx="88" cy="240" r="4.5" fill="#e05a5a" />

              <!-- Cups and an OPEN sign (right) -->
              <g>
                <path d="M300 262 h28 l-3 22 h-22z" fill="#fcf8f3" stroke="#e1c7b3" stroke-width="2" />
                <path d="M328 268 h4 a5 5 0 0 1 0 10 h-5" fill="none" stroke="#e1c7b3" stroke-width="3" />
                <path d="M342 262 h28 l-3 22 h-22z" fill="#f6d9d5" stroke="#e9a8a0" stroke-width="2" />
                <path d="M308 254 q4 -6 0 -12 M318 254 q4 -6 0 -12" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
              </g>
              <g transform="rotate(-5 80 340)">
                <rect x="36" y="318" width="88" height="40" rx="10" fill="#fcf8f3" />
                <text x="80" y="337" text-anchor="middle" font-size="13" font-weight="800" fill="#7a4632" letter-spacing="1">OPEN</text>
                <text x="80" y="351" text-anchor="middle" font-size="10" fill="#9c5f44">좋은 하루 ♡</text>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <!-- MENU -->
    <section id="menu" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Menu · 메뉴 <span lang="km" class="font-khmer font-normal">· ម៉ឺនុយ</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Food, drinks and cakes.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">អាហារ ភេសជ្ជៈ និងនំខេក។</p>

      <!-- Jump buttons: one for each part of the menu -->
      <nav class="sticky top-[72px] z-10 -mx-4 mt-8 flex gap-1.5 overflow-x-auto bg-paper/90 px-4 py-3 backdrop-blur [scrollbar-width:none] sm:mx-0 sm:gap-2 sm:px-0">
        {
          menu.map((part) => (
            <a href={`#${part.id}`} class="flex shrink-0 items-center gap-1.5 rounded-full border border-ink/10 bg-white px-3 py-2 text-sm font-semibold shadow-sm transition hover:border-brand hover:text-brand sm:gap-2 sm:px-5 sm:py-2.5 sm:text-base">
              <span class="hidden sm:inline">{part.icon}</span>
              {part.title}
              <span lang="km" class="font-khmer text-xs font-normal text-muted sm:text-sm">{part.titleKm}</span>
            </a>
          ))
        }
      </nav>

      {
        menu.map((part) => (
          <div id={part.id} class="mt-12 scroll-mt-40">
            <h3 class="flex items-center gap-3 font-display text-3xl font-extrabold">
              <span class="grid size-12 place-items-center rounded-2xl bg-sun/60 text-2xl">{part.icon}</span>
              <span>
                {part.title} <span class="text-lg font-medium text-muted">· {part.ko}</span>
                <span class="km text-lg" lang="km">{part.titleKm}</span>
              </span>
            </h3>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {part.groups.map((group) => (
                <div class="rounded-3xl border border-ink/5 bg-white p-6 shadow-sm sm:p-8">
                  <h4 class="font-display text-xl font-bold">
                    {group.title}
                    <span class="km text-base" lang="km">{group.titleKm}</span>
                  </h4>
                  <ul class="mt-4 divide-y divide-dashed divide-ink/10">
                    {group.items.map((item) => (
                      <li class="flex items-start justify-between gap-4 py-3">
                        <span>
                          <span class="font-semibold">
                            {item.name}
                            {item.star && <span class="ml-1 rounded-full bg-sun px-2 py-0.5 align-middle text-xs font-bold text-brand-dark">♥ Best</span>}
                          </span>
                          <span class="block text-sm text-muted">
                            {item.ko} · <span lang="km">{item.km}</span>
                          </span>
                        </span>
                        <span class="shrink-0 font-display font-bold text-brand">{item.price}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <p class="mt-8 text-center text-sm text-muted">
        All coffee and lattes can be hot or iced. ♡
        <span class="km" lang="km">កាហ្វេ និងឡាតេទាំងអស់ អាចធ្វើក្តៅ ឬត្រជាក់។</span>
      </p>
    </section>

    <!-- OUR CAFÉ -->
    <section id="space" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Our café <span lang="km" class="font-khmer font-normal">· ហាងរបស់យើង</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          A calm place to relax.
        </h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">កន្លែងស្ងប់ស្ងាត់សម្រាប់សម្រាក។</p>
        <ul class="mt-12 grid gap-4 md:grid-cols-3">
          {
            features.map((f) => (
              <li class="rounded-3xl bg-paper p-6">
                <span class="text-3xl">{f.icon}</span>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {f.title}
                  <span class="km text-base" lang="km">{f.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {f.text}
                  <span class="km" lang="km">{f.textKm}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-sun/50">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          Good coffee, sweet treats, and a <span class="text-brand">little moment</span> just for you.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          កាហ្វេឆ្ងាញ់ នំផ្អែម និងពេលវេលាបន្តិចសម្រាប់តែអ្នក។
        </p>
      </div>
    </section>

    <!-- VISIT -->
    <section id="visit" class="scroll-mt-20 px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-[2.5rem] bg-ink px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Come and visit us.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">សូមអញ្ជើញមកលេងយើង។</p>
        <dl class="mx-auto mt-10 grid max-w-3xl gap-6 text-left sm:grid-cols-2">
          <div class="rounded-3xl bg-paper/10 p-5">
            <dt class="font-display font-bold">📍 Where <span lang="km" class="font-khmer font-normal opacity-80">· ទីតាំង</span></dt>
            <dd class="mt-1">
              {site.location}
              <span class="km" lang="km">{site.locationKm}</span>
            </dd>
          </div>
          <div class="rounded-3xl bg-paper/10 p-5">
            <dt class="font-display font-bold">🕖 When <span lang="km" class="font-khmer font-normal opacity-80">· ម៉ោងបើក</span></dt>
            <dd class="mt-1">
              {site.hours}
              <span class="km" lang="km">{site.hoursKm}</span>
            </dd>
          </div>
        </dl>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href={site.telegram} class="rounded-full bg-sun px-8 py-4 font-semibold text-ink transition hover:bg-paper">
            Message on Telegram <span lang="km" class="font-khmer font-normal opacity-70">ផ្ញើសារ</span>
          </a>
          <a href={site.phoneHref} class="rounded-full border border-paper/40 px-8 py-4 font-semibold transition hover:bg-paper/10">
            Call {site.phone}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
