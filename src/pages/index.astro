      {
        title: 'Cakes',
        titleKm: 'នំខេក',
        items: [
          { name: 'Strawberry shortcake', ko: '딸기 케이크', km: 'នំខេកស្ត្របឺរី', price: '$3.50', star: true },
          { name: 'Tiramisu', ko: '티라미수', km: 'នំទីរ៉ាមីស៊ូ', price: '$3.50' },
          { name: 'Basque cheesecake', ko: '바스크 치즈케이크', km: 'នំខេកឈីស', price: '$3.75' },
          { name: 'Chocolate cake', ko: '초코 케이크', km: 'នំខេកសូកូឡា', price: '$3.25' },
          { name: 'Castella (honey sponge cake)', ko: '카스텔라', km: 'នំកាស្តេឡា', price: '$2.50' },
        ],
      },
      {
        title: 'Sweet treats',
        titleKm: 'បង្អែម',
        items: [
