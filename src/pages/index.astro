---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

// TODO: replace with the shop's real menu and prices.
// The menu has 3 parts (Food, Drinks, Cakes). Each part has groups, and each
// group has items. To add something, copy one line inside `items` and change it.
