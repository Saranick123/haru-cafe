    ],
  },
  {
    id: 'drinks',
    icon: '🧋',
    title: 'Drinks',
    ko: '음료',
    titleKm: 'ភេសជ្ជៈ',
    groups: [
      {
        title: 'Coffee',
        titleKm: 'កាហ្វេ',
        items: [
          { name: 'Iced Americano', ko: '아이스 아메리카노', km: 'អាមេរិកាណូទឹកកក', price: '$2.00', star: true },
          { name: 'Café latte', ko: '카페 라떼', km: 'កាហ្វេឡាតេ', price: '$2.50' },
          { name: 'Vanilla latte', ko: '바닐라 라떼', km: 'ឡាតេវ៉ានីឡា', price: '$2.75' },
          { name: 'Caramel macchiato', ko: '카라멜 마키아토', km: 'ម៉ាគីយ៉ាតូការ៉ាមែល', price: '$3.00' },
          { name: 'Einspänner (cream coffee)', ko: '아인슈페너', km: 'កាហ្វេក្រែម', price: '$3.25' },
          { name: 'Dalgona coffee', ko: '달고나 커피', km: 'កាហ្វេដាល់ហ្គោណា', price: '$2.75', star: true },
        ],
      },
      {
