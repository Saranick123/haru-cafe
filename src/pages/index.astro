// TODO: check these match the real café.
const features = [
  {
    icon: '🛋️',
    title: 'Cozy seats',
    titleKm: 'កៅអីស្រួលអង្គុយ',
    text: 'Soft chairs and cool air. Stay as long as you like.',
    textKm: 'កៅអីទន់ៗ និងម៉ាស៊ីនត្រជាក់។ អង្គុយបានយូរតាមចិត្ត។',
  },
  {
    icon: '📸',
    title: 'Photo corner',
    titleKm: 'កន្លែងថតរូប',
    text: 'A pretty spot for your best café photos.',
    textKm: 'កន្លែងស្អាតសម្រាប់ថតរូបនៅហាងកាហ្វេ។',
  },
  {
    icon: '📶',
    title: 'Free Wi-Fi',
    titleKm: 'Wi-Fi ឥតគិតថ្លៃ',
    text: 'Study, work, or chat with friends.',
    textKm: 'រៀន ធ្វើការ ឬជជែកជាមួយមិត្តភក្តិ។',
  },
