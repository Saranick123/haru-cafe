          { name: 'Red bean bingsu', ko: '팥빙수', km: 'ប៊ីងស៊ូសណ្តែកក្រហម', price: '$4.00' },
          { name: 'Croffle with ice cream', ko: '크로플', km: 'ក្រូហ្វលជាមួយការ៉េម', price: '$3.50' },
          { name: 'Honey butter bread', ko: '허니브레드', km: 'នំបុ័ងប៊ឺទឹកឃ្មុំ', price: '$3.75' },
